  "notes_ru": [
    {
      "label": "ПРИМЕЧАНИЕ 1",
      "text": "Сетчатые фильтры рекомендуются для капилляров, дросселей из спечённого металла и ограничительных диафрагм диаметром менее 3 мм (1/8″)."
    },
    {
      "label": "ПРИМЕЧАНИЕ 2",
      "text": "Регуляторы перепада давления рекомендуются, если давление подачи продувки или процесса изменяет расход продувки более чем на ±10 %."
    },
    {
      "label": "ПРИМЕЧАНИЕ 3",
      "text": "Сверлёные задвижки-дроссели не требуют байпасного/промывочного клапана."
    },
    {
      "label": "ПРИМЕЧАНИЕ 4",
      "text": "Обратный клапан и трубопровод после него должны соответствовать условиям процесса."
    },
    {
      "label": "ПРИМЕЧАНИЕ 5",
      "text": "Трубопровод подачи продувки может быть общим с соответствующими сервисами, например со вторым отбором преобразователя уровня или расхода."
    },
    {
      "label": "ПРИМЕЧАНИЕ 6",
      "text": "Байпасные/промывочные линии рекомендуются для типов C–E, чтобы систему можно было проверить на закупоривание с помощью манометра."
    }
  ],
