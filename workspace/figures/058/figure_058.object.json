  "notes_ru": [
    {
      "label": "ПРИМЕЧАНИЕ 1",
      "text": "Показаны манометрические клапаны; допускается применение задвижек по спецификации трубопровода, особенно если требуются тройники для прочистки шомполом."
    },
    {
      "label": "ПРИМЕЧАНИЕ 2",
      "text": "Импульсные линии должны иметь минимальную длину и быть симметричными."
    },
    {
      "label": "ПРИМЕЧАНИЕ 3",
      "text": "Уклон линии должен быть не менее 1:12 для исключения карманов и обеспечения выпуска газа или дренирования."
    },
    {
      "label": "ПРИМЕЧАНИЕ 4",
      "text": "Отбор высокого давления прибора присоединять к стороне трубопровода выше по потоку."
    },
    {
      "label": "ПРИМЕЧАНИЕ 5",
      "text": "Для жидких сред предпочтительно направление потока снизу вверх."
    },
    {
      "label": "ПРИМЕЧАНИЕ 6",
      "text": "Для жидкостей, пара и конденсирующихся паров прибор устанавливать ниже отборов."
    },
    {
      "label": "ПРИМЕЧАНИЕ 7",
      "text": "Для неконденсирующегося газа расходомер устанавливать выше отборов."
    },
    {
      "label": "ПРИМЕЧАНИЕ 8",
      "text": "Для паровой среды оба заполняющих тройника должны находиться на одном уровне с верхним отбором."
    }
  ],
